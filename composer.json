{
    "name": "amjadiqbal/refresher",
    "description": "Cache your test database schema and skip re-migration: restore a cached snapshot instead of running migrate:fresh on every test process or CI run.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "amjadiqbal",
        "laravel",
        "laravel-package",
        "testing",
        "test-database",
        "refreshdatabase",
        "migrations",
        "migrate-fresh",
        "sqlite",
        "mysql",
        "ci",
        "phpunit",
        "pest",
        "database-snapshot"
    ],
    "homepage": "https://github.com/AmjadIqbal/refresher",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/AmjadIqbal/refresher/issues",
        "source": "https://github.com/AmjadIqbal/refresher"
    },
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\Refresher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\Refresher\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\Refresher\\RefresherServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
